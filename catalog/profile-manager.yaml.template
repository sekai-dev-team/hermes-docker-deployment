name: profile-manager
type: server
title: Hermes Profile Manager
description: Restricted Docker MCP profile management for the Hermes deployment.
image: @PROFILE_MANAGER_IMAGE@
longLived: true
env:
  - name: PROFILE_ID
    value: @PROFILE_ID@
  - name: CATALOG_REF
    value: @CATALOG_REF@
  - name: ALLOWED_SERVERS
    value: @ALLOWED_SERVERS@
volumes:
  - hermes-mcp-config:/root/.docker/mcp
tools:
  - name: profile_list
    description: List Docker MCP profiles.
  - name: profile_show
    description: Show the managed Docker MCP profile.
  - name: profile_server_add
    description: Add an allowlisted catalog server to the managed profile.
  - name: profile_server_remove
    description: Remove an allowlisted server from the managed profile.
  - name: catalog_list
    description: List Docker MCP catalogs available to the gateway.
  - name: catalog_pull_official
    description: Pull the configured official Docker MCP catalog.
