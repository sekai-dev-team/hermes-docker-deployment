HERMES_IMAGE=local/hermes-agent-docker-cli:latest
HERMES_CONTAINER_NAME=hermes
HERMES_DATA_DIR=/home/<your_username>/.hermes
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_UID=10000
HERMES_GID=10000
INNER_DOCKER_IMAGE=docker:27-dind
INNER_DOCKER_CONTAINER_NAME=inner-docker
INNER_DOCKER_HOST=tcp://inner-docker:2375
INNER_DOCKER_DATA_VOLUME=inner-docker-data
INNER_WORKLOAD_PORT_START=20000
INNER_WORKLOAD_PORT_END=20100
MCP_GATEWAY_IMAGE=docker/mcp-gateway:latest
MCP_GATEWAY_CONTAINER_NAME=mcp-gateway
MCP_GATEWAY_PORT=8811
MCP_GATEWAY_TRANSPORT=streaming
MCP_GATEWAY_URL=http://inner-docker:8811/mcp
MCP_GATEWAY_PROFILE=hermes-default
MCP_GATEWAY_CATALOG_REF=mcp/docker-mcp-catalog:latest
PROFILE_MANAGER_IMAGE=local/hermes-profile-manager:latest
PROFILE_MANAGER_ALLOWED_SERVERS=*
COMPOSE_PROJECT_NAME=hermes-docker-deployment
